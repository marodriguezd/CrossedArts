# === CrossedArts Configuration ===
# Copy this file to ~/.crossedarts/.env (or legacy ~/.domestik/.env) and customize.
# All values here are optional — defaults work out of the box.
#
# IMPORTANTE: los nombres de variable son EXACTOS (DATABASE_URL, PORT, ...).
# pydantic-settings no usa prefijo: cualquier nombre con prefijo tipo
# `CROSSEDARTS_DATABASE_URL` o `CROSSEDARTS_PORT` se IGNORA EN SILENCIO.

# === Server ===
# PORT=8080
# HOST=127.0.0.1
#
# La API no tiene autenticación: por defecto solo escucha en localhost. Enlazar
# una interfaz no local (p. ej. HOST=0.0.0.0) se RECHAZA al arrancar salvo que se
# autorice aquí de forma explícita. Hacerlo expone una API de escritura sin
# autenticación a la red; protege el puerto con cortafuegos o un reverse proxy.
# ALLOW_NETWORK_ACCESS=false
#
# Si usas Ollama, define su CORS con tu origen exacto, nunca con "*":
# OLLAMA_ORIGINS=http://localhost:5173

# === Database ===
# Leave empty to use default ~/.crossedarts/crossedarts.db (or legacy ~/.domestik/domestik.db)
# DATABASE_URL=sqlite:///custom/path/crossedarts.db

# === LLM Provider ===
# Options: mock (default, no API needed), ollama (local), openai (or compatible)
# LLM_PROVIDER=mock

# OpenAI / Compatible (DeepSeek, Gemini, LocalAI, etc.)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local inference)
# OLLAMA_API_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3:8b

# === Embedding Provider ===
# Options: mock, ollama, openai, huggingface (default)
EMBEDDING_PROVIDER=huggingface

# HUGGINGFACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OPENAI_EMBED_MODEL=text-embedding-3-small
# SEMANTIC_SCAN_LIMIT=3000  # Personal-scale scan limit for SQLite vector similarity (scans newest N records)

# === LangSmith / LangChain (optional) ===
# Enable tracing for debugging and monitoring
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-your-key-here
# LANGCHAIN_PROJECT=crossedarts

